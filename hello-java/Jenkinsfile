pipeline {
    agent {
        docker {
            image 'eclipse-temurin:21-jdk'
        }
    }

    stages {
        stage('Compile') {
            steps {
                sh 'javac -d out hello-java/src/HelloWorld.java'
            }
        }

        stage('Run') {
            steps {
                sh 'java -cp out HelloWorld'
            }
        }
    }
}
